{
  "annotations": {
    "list": []
  },
  "description": "Core service, vLLM, GPU, and Kubernetes signals for the Seldon VLLM_SERVER runtime.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(llm_adapter_requests_total{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"}[5m]))",
          "legendFormat": "requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(llm_adapter_requests_total{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\",status!~\"2..\"}[5m])) / clamp_min(sum(rate(llm_adapter_requests_total{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"}[5m])), 0.001)",
          "legendFormat": "errors",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_adapter_request_duration_seconds_bucket{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Adapter request latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"}[5m])))",
          "legendFormat": "p95 TTFT",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Time to first token p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(vllm:generation_tokens_total{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"}[5m]))",
          "legendFormat": "output tokens/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Output token throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(vllm:num_requests_waiting{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"})",
          "legendFormat": "waiting",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Waiting requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * max(vllm:gpu_cache_usage_perc{namespace=~\"$namespace\",seldon_deployment=~\"$seldon_deployment\"})",
          "legendFormat": "KV cache",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "KV cache usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(DCGM_FI_DEV_FB_USED) / clamp_min(sum(DCGM_FI_DEV_FB_USED) + sum(DCGM_FI_DEV_FB_FREE), 1)",
          "legendFormat": "framebuffer",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU memory usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU temperature",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\",deployment=~\"$seldon_deployment.*\"})",
          "legendFormat": "available replicas",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_status_ready{namespace=~\"$namespace\",pod=~\"$pod\",condition=\"true\"})",
          "legendFormat": "ready pods",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "container restarts",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Kubernetes workload health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{container}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{container}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container memory working set",
      "type": "timeseries"
    }
  ],
